# Pipeline 2 (Creative) - Environment Variables
# This file documents optional environment variables for P2.
# Copy to .env and fill in values if needed.

# No required variables for P2.
# P2 operates on P1 research output and generates creative strategy.
# External API calls (if any) are mocked in tests.

# Optional: Visual generation parameters
VISUAL_GENERATION_QUALITY=high
PROMPT_DIVERSITY=medium

# Optional: Debugging
DEBUG=false
VERBOSE_LOGGING=false
